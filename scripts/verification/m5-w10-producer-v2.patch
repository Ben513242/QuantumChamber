+        if ($parent -eq $cursor) { break }; $cursor=$parent
+    }
+    if ($Absent -and (Get-Item -LiteralPath $full -Force -ErrorAction SilentlyContinue)) { throw "W10_EXISTS：$full" }
+    return $full
